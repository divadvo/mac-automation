# Local configuration - copy to local.yml and fill in your values
# This file is gitignored and won't be tracked

# Verify SSH-ID login from a second Termius session before key-only auth.
remote_access_enabled: false
sshid_handle: ""
ssh_key_only_auth: false
remote_access_allowed_users:
  - "your-macos-short-name"
remote_access_configure_firewall: false

user_email: "your@email.com"
user_name: "Your Name"
