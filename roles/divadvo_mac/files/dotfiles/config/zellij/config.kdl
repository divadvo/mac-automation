// Compact, phone-friendly defaults shared by macOS and Ubuntu.
default_shell "zsh"
default_layout "compact"
simplified_ui true
pane_frames false
mouse_mode true
scroll_buffer_size 50000
on_force_close "detach"

// Active sessions survive disconnects. After a reboot, restore only the
// layout and commands; do not persist terminal viewport or scrollback text.
session_serialization true
serialize_pane_viewport false

// Keep laptop and phone clients independent unless `zj mirror` is used.
mirror_session false

// OSC 52 is the only clipboard method that can reach a remote SSH/Mosh client.
// Deliberately do not set copy_command (for example, pbcopy).
copy_clipboard "system"
copy_on_select true

// Zellij switches these when the terminal reports its appearance. Terminals
// without appearance reporting use the dark fallback.
theme "one-half-dark"
theme_dark "one-half-dark"
theme_light "dayfox"

show_startup_tips false
show_release_notes false
