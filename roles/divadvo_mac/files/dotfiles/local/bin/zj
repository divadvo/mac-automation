#!/usr/bin/env bash
set -euo pipefail

usage() { printf 'usage: zj {claude|codex|opencode} [--awake] [SESSION]\n'; }

agent="${1:-}"
shift || true
case "$agent" in
  claude|codex|opencode) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 64 ;;
esac

awake=0
if [[ "${1:-}" == "--awake" ]]; then awake=1; shift; fi
(( $# <= 1 )) || { usage >&2; exit 64; }
session="${1:-${agent}-$(basename "$PWD")}"
export ZJ_AGENT="$agent" ZJ_AGENT_AWAKE="$awake"

if zellij list-sessions --short 2>/dev/null | grep -Fxq -- "$session"; then
  exec zellij attach --force-run-commands "$session"
fi

exec zellij --session "$session" --layout-string 'layout { pane command="zsh" name="Agent" { args "-lic" "[[ $ZJ_AGENT_AWAKE == 1 && $OSTYPE == darwin* ]] && exec caffeinate -dimsu $ZJ_AGENT; exec $ZJ_AGENT"; }; pane size=1 borderless=true { plugin location="compact-bar"; }; }'
